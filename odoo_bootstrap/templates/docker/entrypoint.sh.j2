#!/bin/bash
# BizApps Odoo {{ version }} entrypoint — generated by odoo-bootstrap
set -e

# Wait for PostgreSQL
until pg_isready -h "${DB_HOST:-postgres}" -p "${DB_PORT:-5432}" -U "${DB_USER:-odoo}"; do
    echo "Waiting for PostgreSQL..."
    sleep 2
done

# Install any requirements from custom addons
if [ -f "/opt/custom_addons/requirements.txt" ]; then
    pip install --quiet -r /opt/custom_addons/requirements.txt
fi

# Run Odoo
if [ "$1" = "odoo" ]; then
    exec python /opt/odoo/{{ version }}.0/odoo-bin \
        --config=/etc/odoo/odoo.conf \
        "${@:2}"
elif [ "$1" = "shell" ]; then
    exec python /opt/odoo/{{ version }}.0/odoo-bin shell \
        --config=/etc/odoo/odoo.conf \
        "${@:2}"
else
    exec "$@"
fi
