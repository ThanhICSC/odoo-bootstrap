# ============================================================
# BizApps Custom Odoo {{ version }} Docker Image
# Built by odoo-bootstrap — do not edit manually
# ============================================================
FROM python:3.12-slim-bookworm

LABEL maintainer="BizApps Team <dev@bizapps.vn>"
LABEL odoo.version="{{ version }}"

# ── System dependencies ───────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Odoo runtime
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    libjpeg-dev \
    libpng-dev \
    zlib1g-dev \
    libffi-dev \
    # Node / wkhtmltopdf
    nodejs \
    npm \
    wkhtmltopdf \
    # Utilities
    git \
    curl \
    wget \
    ca-certificates \
    gnupg \
    locales \
    fonts-noto \
    fonts-noto-cjk \
    # Build tools
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# ── Locale ────────────────────────────────────────────────────────────────────
RUN locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# ── Odoo user ────────────────────────────────────────────────────────────────
RUN adduser --disabled-password --gecos '' --uid 1000 odoo

# ── Python packages ──────────────────────────────────────────────────────────
RUN pip install --upgrade pip setuptools wheel

# Core Odoo Python dependencies
RUN pip install \
    psycopg2-binary \
    Pillow \
    lxml \
    openpyxl \
    xlsxwriter \
    xlrd \
    pandas \
    numpy \
    matplotlib \
    beautifulsoup4 \
    reportlab \
    cryptography \
    qrcode \
    requests \
    zeep \
    phonenumbers \
    paramiko \
    pdfplumber \
    num2words \
    Babel \
    passlib \
    watchdog \
    jinja2 \
    black \
    ruff \
    isort \
    pyyaml \
    python-stdnum \
    vobject \
    pyserial \
    pyotp \
    freezegun \
    python-dateutil \
    pytz \
    werkzeug \
    decorator \
    docopt \
    libsass \
    gevent \
    greenlet \
    polib \
    chardet

{% if extra_pip_packages %}
# Project-specific packages
RUN pip install {{ extra_pip_packages | join(' ') }}
{% endif %}

# ── Odoo source ───────────────────────────────────────────────────────────────
RUN mkdir -p /opt/odoo /opt/enterprise /opt/custom_addons /var/log/odoo /var/lib/odoo
COPY --chown=odoo:odoo source/ /opt/odoo/{{ version }}.0/

# Install Odoo requirements from source
RUN if [ -f "/opt/odoo/{{ version }}.0/requirements.txt" ]; then \
    pip install -r /opt/odoo/{{ version }}.0/requirements.txt; \
    fi

# ── Directories & permissions ─────────────────────────────────────────────────
RUN chown -R odoo:odoo /opt/odoo /opt/enterprise /opt/custom_addons \
    /var/log/odoo /var/lib/odoo

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME ["/var/lib/odoo", "/opt/custom_addons"]

EXPOSE 8069 8071 8072

USER odoo
WORKDIR /opt/odoo/{{ version }}.0

ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
