# ============================================================
# BizApps Odoo Dev — Makefile
# Generated by odoo-bootstrap
# ============================================================

.PHONY: help init doctor status start stop restart rebuild clean backup logs shell update

SHELL := /bin/bash

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

init: ## Initialize workspace and all versions
	odoo-bootstrap init

doctor: ## Check system health
	odoo-bootstrap doctor

status: ## Show running services and projects
	odoo-bootstrap status

{% for name in project_names %}
start-{{ name }}: ## Start project {{ name }}
	odoo-bootstrap start {{ name }}

stop-{{ name }}: ## Stop project {{ name }}
	odoo-bootstrap stop {{ name }}

restart-{{ name }}: ## Restart project {{ name }}
	odoo-bootstrap restart {{ name }}

logs-{{ name }}: ## Tail logs for {{ name }}
	odoo-bootstrap logs {{ name }} --follow

backup-{{ name }}: ## Backup project {{ name }}
	odoo-bootstrap backup {{ name }}

shell-{{ name }}: ## Open Odoo shell for {{ name }}
	odoo-bootstrap shell {{ name }}

{% endfor %}

start: ## Start all projects
{% for name in project_names %}
	odoo-bootstrap start {{ name }}
{% endfor %}

stop: ## Stop all projects
{% for name in project_names %}
	odoo-bootstrap stop {{ name }}
{% endfor %}

rebuild: ## Rebuild all Docker images
	odoo-bootstrap rebuild

clean: ## Clean stopped containers and dangling images
	odoo-bootstrap clean

update: ## Git pull all Odoo sources and rebuild
	odoo-bootstrap update

backup: ## Backup all projects
{% for name in project_names %}
	odoo-bootstrap backup {{ name }}
{% endfor %}

requirements: ## Install/update Python packages in containers
	odoo-bootstrap requirements

.DEFAULT_GOAL := help
