# ============================================================
# Shared infrastructure services — BizApps Odoo Dev
# Generated by odoo-bootstrap
# ============================================================

version: "3.9"

networks:
  odoo-net:
    driver: bridge
    name: bizapps-odoo-net

services:

  # ── PostgreSQL shared ─────────────────────────────────────────────────────
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: bizapps-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
      POSTGRES_DB: postgres
    ports:
      - "5432:5432"
    volumes:
      - postgres-shared-data:/var/lib/postgresql/data
      - ./init-db.sh:/docker-entrypoint-initdb.d/init-db.sh:ro
    networks:
      - odoo-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

{% if enable_pgadmin %}
  # ── PgAdmin ───────────────────────────────────────────────────────────────
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: bizapps-pgadmin
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: {{ pgadmin_email }}
      PGADMIN_DEFAULT_PASSWORD: {{ pgadmin_password }}
    ports:
      - "{{ pgadmin_port }}:80"
    networks:
      - odoo-net
    volumes:
      - pgadmin-data:/var/lib/pgadmin
    depends_on:
      postgres:
        condition: service_healthy
{% endif %}

{% if enable_mailpit %}
  # ── Mailpit ────────────────────────────────────────────────────────────────
  mailpit:
    image: axllent/mailpit:latest
    container_name: bizapps-mailpit
    restart: unless-stopped
    ports:
      - "{{ mailpit_http_port }}:8025"
      - "{{ mailpit_smtp_port }}:1025"
    networks:
      - odoo-net
{% endif %}

{% if enable_redis %}
  # ── Redis ─────────────────────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    container_name: bizapps-redis
    restart: unless-stopped
    ports:
      - "{{ redis_port }}:6379"
    networks:
      - odoo-net
    command: redis-server --appendonly yes
    volumes:
      - redis-data:/data
{% endif %}

{% if enable_adminer %}
  # ── Adminer ───────────────────────────────────────────────────────────────
  adminer:
    image: adminer:latest
    container_name: bizapps-adminer
    restart: unless-stopped
    ports:
      - "{{ adminer_port }}:8080"
    networks:
      - odoo-net
{% endif %}

volumes:
  postgres-shared-data:
  pgadmin-data:
  redis-data:
