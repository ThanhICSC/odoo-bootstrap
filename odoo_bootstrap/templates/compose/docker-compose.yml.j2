# ============================================================
# BizApps Odoo {{ version }} — {{ project_name }}
# Generated by odoo-bootstrap
# ============================================================

version: "3.9"

networks:
  odoo-net:
    driver: bridge

services:

  postgres:
    image: postgres:{{ postgres_version }}
    container_name: {{ project_name }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-{{ db_user }}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-{{ db_password }}}
      POSTGRES_DB: postgres
    volumes:
      - postgres-data-{{ project_name }}:/var/lib/postgresql/data
    networks:
      - odoo-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  odoo:
    image: odoo:{{ version }}
    container_name: {{ project_name }}-odoo
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      HOST: postgres
      PORT: 5432
      USER: ${POSTGRES_USER:-{{ db_user }}}
      PASSWORD: ${POSTGRES_PASSWORD:-{{ db_password }}}
      DB: ${DB_NAME:-{{ db_name }}}
    ports:
      - "{{ odoo_port }}:8069"
      - "{{ longpoll_port }}:8072"
    volumes:
      - {{ filestore_dir }}:/var/lib/odoo
      - {{ custom_addons_dir }}:/mnt/extra-addons
{% if has_enterprise %}
      - {{ enterprise_dir }}:/mnt/enterprise
{% endif %}
      - {{ config_dir }}/odoo.conf:/etc/odoo/odoo.conf:ro
      - {{ logs_dir }}:/var/log/odoo
    networks:
      - odoo-net

{% if enable_mailpit %}
  mailpit:
    image: axllent/mailpit:latest
    container_name: {{ project_name }}-mailpit
    restart: unless-stopped
    ports:
      - "{{ mailpit_http_port }}:8025"
      - "{{ mailpit_smtp_port }}:1025"
    networks:
      - odoo-net
{% endif %}

volumes:
  postgres-data-{{ project_name }}:
