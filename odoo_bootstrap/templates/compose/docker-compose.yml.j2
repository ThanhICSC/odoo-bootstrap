# ============================================================
# BizApps Odoo {{ version }} — {{ project_name }}
# Generated by odoo-bootstrap — do not edit manually
# Edit docker-compose.override.yml for local customizations
# ============================================================

version: "3.9"

networks:
  odoo-net:
    external: true
    name: bizapps-odoo-net

volumes:
  odoo-filestore-{{ project_name }}:
  odoo-logs-{{ project_name }}:

services:

  # ── PostgreSQL ──────────────────────────────────────────────────────────────
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: {{ project_name }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-{{ db_user }}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-{{ db_password }}}
      POSTGRES_DB: postgres
    volumes:
      - postgres-data-{{ project_name }}:/var/lib/postgresql/data
    networks:
      - odoo-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-{{ db_user }}}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Odoo ────────────────────────────────────────────────────────────────────
  odoo:
    image: bizapps-odoo:{{ version }}
    container_name: {{ project_name }}-odoo
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DB_HOST: postgres
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER:-{{ db_user }}}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-{{ db_password }}}
      DB_NAME: ${DB_NAME:-{{ db_name }}}
    ports:
      - "${ODOO_PORT:-{{ odoo_port }}}:8069"
      - "${LONGPOLL_PORT:-{{ longpoll_port }}}:8072"
    volumes:
      - {{ filestore_dir }}:/var/lib/odoo
      - {{ custom_addons_dir }}:/opt/custom_addons
      - {{ config_dir }}/odoo.conf:/etc/odoo/odoo.conf:ro
      - {{ logs_dir }}:/var/log/odoo
    networks:
      - odoo-net
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8069/web/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

{% if enable_mailpit %}
  # ── Mailpit ─────────────────────────────────────────────────────────────────
  mailpit:
    image: axllent/mailpit:latest
    container_name: {{ project_name }}-mailpit
    restart: unless-stopped
    ports:
      - "${MAILPIT_HTTP_PORT:-{{ mailpit_http_port }}}:8025"
      - "${MAILPIT_SMTP_PORT:-{{ mailpit_smtp_port }}}:1025"
    networks:
      - odoo-net
{% endif %}

{% if enable_redis %}
  # ── Redis ────────────────────────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    container_name: {{ project_name }}-redis
    restart: unless-stopped
    ports:
      - "${REDIS_PORT:-{{ redis_port }}}:6379"
    networks:
      - odoo-net
    command: redis-server --appendonly yes
    volumes:
      - redis-data-{{ project_name }}:/data
{% endif %}

{% if enable_pgadmin %}
  # ── PgAdmin ──────────────────────────────────────────────────────────────────
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: {{ project_name }}-pgadmin
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_EMAIL:-{{ pgadmin_email }}}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_PASSWORD:-{{ pgadmin_password }}}
    ports:
      - "${PGADMIN_PORT:-{{ pgadmin_port }}}:80"
    networks:
      - odoo-net
    volumes:
      - pgadmin-data-{{ project_name }}:/var/lib/pgadmin
{% endif %}

{% if enable_adminer %}
  # ── Adminer ──────────────────────────────────────────────────────────────────
  adminer:
    image: adminer:latest
    container_name: {{ project_name }}-adminer
    restart: unless-stopped
    ports:
      - "${ADMINER_PORT:-{{ adminer_port }}}:8080"
    networks:
      - odoo-net
{% endif %}

volumes:
  postgres-data-{{ project_name }}:
  redis-data-{{ project_name }}:
  pgadmin-data-{{ project_name }}:
