[options]
; Database
db_host = {{ db.host }}
db_port = {{ db.port }}
db_user = {{ db.user }}
db_password = {{ db.password }}
db_name = {{ db.name }}

; Addons
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons{% if '/mnt/enterprise' in addons_path %},/mnt/enterprise{% endif %}

; HTTP
http_port = 8069
proxy_mode = {{ 'True' if odoo.proxy_mode else 'False' }}

; Workers
workers = {{ odoo.workers }}
max_cron_threads = {{ odoo.max_cron_threads }}

; Logging
log_level = {{ odoo.log_level }}

; Email
smtp_server = {{ odoo.smtp_server }}
smtp_port = {{ odoo.smtp_port }}

; Data
data_dir = /var/lib/odoo
