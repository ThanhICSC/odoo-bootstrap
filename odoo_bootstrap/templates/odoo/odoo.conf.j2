; ============================================================
; Odoo {{ version }} — {{ project_name }}
; Generated by odoo-bootstrap — do not edit manually
; ============================================================

[options]
; ── Database ─────────────────────────────────────────────────────────────────
db_host = {{ db.host }}
db_port = {{ db.port }}
db_user = {{ db.user }}
db_password = {{ db.password }}
db_name = {{ db.name }}
db_maxconn = 64

; ── Addons path ──────────────────────────────────────────────────────────────
addons_path = {{ addons_path | join(',') }}

; ── HTTP ─────────────────────────────────────────────────────────────────────
xmlrpc_port = 8069
http_port = 8069
proxy_mode = {{ 'True' if odoo.proxy_mode else 'False' }}
longpolling_port = 8072

; ── Workers ──────────────────────────────────────────────────────────────────
workers = {{ odoo.workers }}
max_cron_threads = {{ odoo.max_cron_threads }}

; ── Limits ───────────────────────────────────────────────────────────────────
limit_memory_hard = {{ odoo.limit_memory_hard }}
limit_memory_soft = {{ odoo.limit_memory_soft }}
limit_request = {{ odoo.limit_request }}
limit_time_cpu = {{ odoo.limit_time_cpu }}
limit_time_real = {{ odoo.limit_time_real }}

; ── Logging ──────────────────────────────────────────────────────────────────
log_level = {{ odoo.log_level }}
logfile = /var/log/odoo/odoo.log
log_handler = :{{ odoo.log_level | upper }}

; ── Email (Mailpit in dev) ────────────────────────────────────────────────────
smtp_server = {{ odoo.smtp_server }}
smtp_port = {{ odoo.smtp_port }}
smtp_ssl = {{ 'True' if odoo.smtp_ssl else 'False' }}

; ── Data ─────────────────────────────────────────────────────────────────────
data_dir = /var/lib/odoo

; ── Developer mode ───────────────────────────────────────────────────────────
dev = {{ odoo.dev_mode }}
